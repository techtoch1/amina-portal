# Copy to .env and fill in. NEVER commit .env.

# --- Wbiztool credentials ---
WBIZ_CLIENT_ID=          # integer
WBIZ_API_KEY=
WBIZ_WHATSAPP_CLIENT=    # the WhatsApp client / instance id from your Wbiztool account

# --- Phone numbers (digits with country code, e.g. 9617XXXXXXX) ---
MOM_NUMBER=
MY_NUMBER=

# --- Dashboard login (single user) ---
DASHBOARD_PASSWORD=      # at least 10 characters
# Optional; generated into data/.secret_key if empty
SECRET_KEY=

# --- Behaviour ---
TIMEZONE=Asia/Beirut
SEND_COPY_TO_ME=true     # default for the dashboard toggle

# true when served over HTTPS (required behind a reverse proxy with TLS).
# Set to false only for plain-http local testing.
COOKIE_SECURE=true
HOST=127.0.0.1
PORT=8000

# Wbiztool endpoint paths/field names in app/wbiztool.py were written without
# access to the docs. Reminders and messages are BLOCKED until you have checked
# them against https://wbiztool.com/docs/ and set this to true.
WBIZ_DOCS_VERIFIED=false
